{
    "name": "elmudo-dev/filament-rich-media-plugins",
    "description": "A collection of standalone Filament rich editor plugins (LinkButton, Image) compatible with v4 and v5.",
    "keywords": [
        "elmudo-dev",
        "laravel",
        "filament-rich-media-plugins"
    ],
    "homepage": "https://github.com/elmudometal/filament-rich-media-plugins",
    "license": "MIT",
    "authors": [
        {
            "name": "Hernan Soto",
            "email": "guzman.hernan.j@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0||^13.0",
        "filament/filament": "^4.0 || ^5.0",
        "ueberdosis/tiptap-php": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "ElmudoDev\\FilamentRichMediaPlugins\\": "src/",
            "ElmudoDev\\FilamentRichMediaPlugins\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElmudoDev\\FilamentRichMediaPlugins\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElmudoDev\\FilamentRichMediaPlugins\\FilamentRichMediaPluginsServiceProvider"
            ],
            "aliases": {
                "FilamentRichMediaPlugins": "ElmudoDev\\FilamentRichMediaPlugins\\Facades\\FilamentRichMediaPlugins"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
